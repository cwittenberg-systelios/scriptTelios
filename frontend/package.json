{
  "name": "systelios-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "python3 ../backend/scripts/export_prompt_defaults.py",
    "build": "vite build",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch",
    "lint": "eslint ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@jest/globals": "^29.7.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-jest": "^29.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "vite": "^6.0.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.jsx?$": [
        "babel-jest",
        {
          "configFile": "./babel-jest.config.cjs"
        }
      ]
    },
    "moduleFileExtensions": [
      "js",
      "jsx",
      "mjs"
    ],
    "testMatch": [
      "**/tests/**/*.test.{js,jsx}"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/api.js",
      "src/shared.js",
      "src/workflow-run.jsx"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
