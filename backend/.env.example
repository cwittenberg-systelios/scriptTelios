# ════════════════════════════════════════════════════════════════
#  sysTelios KI-Dokumentation – Umgebungsvariablen
#  Kopiere diese Datei zu .env und passe die Werte an.
#
#  Docker (lokale Entwicklung / Produktion):
#    cp .env.example .env
#    docker compose up -d
#
#  RunPod (ohne Docker):
#    Wird automatisch vom runpod-start.sh erstellt.
# ════════════════════════════════════════════════════════════════

# ── LLM ──────────────────────────────────────────────────────────
# Docker:   http://ollama:11434  (Service-Name im Docker-Netzwerk)
# RunPod:   http://localhost:11434
OLLAMA_HOST=http://localhost:11434
# ── Modell-Empfehlungen (Stand: Maerz 2026) ──────────────────────
#
# WICHTIG: Qwen3 statt Qwen2.5 verwenden!
# Qwen3-32B wurde auf 36 Billionen Token trainiert (2x so viel wie Qwen2.5),
# 119 Sprachen, besseres Deutsch, besseres Instruction Following.
# Qwen3-32B-Base ≈ Qwen2.5-72B-Base in Benchmarks – bei halber Groesse.
#
# RTX Pro 4500 Blackwell (32GB VRAM):
#   qwen3:32b-q4_K_M  ~19GB + ~4GB KV-Cache = ~23GB           <- EMPFEHLUNG
#   ACHTUNG Blackwell: Ollama >= 0.17 erforderlich! (CUDA 13 / Compute 12.0)
#   Aeltere Versionen fallen stillschweigend auf CPU zurueck.
#   Pruefung: ollama ps → Processor-Spalte muss "100% GPU" zeigen.
#   Falls CPU-Fallback: curl -fsSL https://ollama.com/install.sh | sh
#
# RTX 4090 (24GB VRAM):
#   qwen3:32b-q4_K_S  ~18GB, passt mit kleinem Kontext (num_ctx ≤ 6144)
#   ODER: OLLAMA_FLASH_ATTENTION=true + OLLAMA_KV_CACHE_TYPE=q8_0
#         → halbiert KV-Cache → q4_K_M passt dann auch!
#   Fallback: qwen3:14b-q5_K_M (~10GB) – viel Headroom, gute Qualitaet
#
# NICHT empfohlen fuer klinische Dokumentation:
#   qwen2.5:32b       Deutlich schlechteres Deutsch und Instruction Following
#   deepseek-r1:32b   Reasoning-Modell, duenner Fliesstext, schwaches Deutsch
#   qwen3:30b-a3b     MoE (nur 3B aktiv), zu duenn fuer 600+ Woerter Fliesstext
#
OLLAMA_MODEL=qwen3:32b

# ── Whisper ───────────────────────────────────────────────────────
# WHISPER_DEVICE: cpu (ohne GPU) | cuda (mit NVIDIA-GPU)
# WHISPER_COMPUTE_TYPE: int8 (CPU) | float16 (GPU)
# Hinweis: Bei langen Aufnahmen (>30 Min) kann CUDA out-of-memory auftreten.
# In diesem Fall WHISPER_DEVICE=cpu und WHISPER_COMPUTE_TYPE=int8 setzen
# oder das Backend startet automatisch einen CPU-Fallback.
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# Ollama vor Whisper aus VRAM entladen?
# False (Standard): Whisper + Ollama teilen VRAM – kein LLM-Kaltstart nach Transkription.
#   Empfohlen für RTX 4090 (24GB): large-v3 (~3GB) + mistral-nemo (~5GB) passen gleichzeitig.
# True: Für kleinere GPUs (<12GB) – Whisper bekommt den ganzen VRAM,
#   aber der erste LLM-Aufruf nach Transkription dauert ~20-30s (Kaltstart).
WHISPER_FREE_OLLAMA_VRAM=false

# ── Datenbank ─────────────────────────────────────────────────────
# Docker:   @db:5432        (Service-Name im Docker-Netzwerk)
# RunPod:   @127.0.0.1:5432 (direkt, kein Docker-Netzwerk)
# WICHTIG:  Kein ?sslmode= Parameter noetig – SSL wird in database.py
#           via connect_args={"ssl": False} deaktiviert.
DATABASE_URL=postgresql+asyncpg://systelios:systelios@db:5432/systelios

# ── Datenschutz ───────────────────────────────────────────────────
# Audiodateien nach Transkription loeschen (empfohlen: true)
DELETE_AUDIO_AFTER_TRANSCRIPTION=true

# ── CORS ──────────────────────────────────────────────────────────
# Confluence-URL eintragen damit Anfragen vom Intranet erlaubt werden.
# Beispiel: http://intranet.systelios.local oder https://wiki.systelios.de
CONFLUENCE_URL=http://intranet.systelios.local

# Weitere erlaubte Origins (kommagetrennt):
# EXTRA_CORS_ORIGINS=https://mein-client.de

# RunPod-Proxy-Domain erlauben (Testphase):
# true  → https://*.proxy.runpod.net wird erlaubt
# false → nur explizit eingetragene Origins (Produktion)
ALLOW_RUNPOD_PROXY=false

# Cloudflare-Tunnel erlauben (Testphase via 'cloudflared tunnel --url ...'):
# true  → https://*.trycloudflare.com wird erlaubt
# false → nur explizit eingetragene Origins (Produktion)
ALLOW_CLOUDFLARE_TUNNEL=true

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=systelios.log

# ── Sprecher-Diarization (pyannote.audio) ───────────────────────
# Echte Sprecher-Erkennung (~90% Genauigkeit) statt Pausen-Heuristik (~50%).
# Setup:
#   1. pip install pyannote.audio
#   2. Account auf huggingface.co erstellen (kostenlos)
#   3. Modell freischalten: huggingface.co/pyannote/speaker-diarization-3.1
#   4. Token generieren: huggingface.co/settings/tokens
#   5. DIARIZATION_ENABLED=true und Token eintragen
# VRAM-Bedarf: ~2GB zusätzlich zu Whisper (~3GB) = ~5GB gesamt
DIARIZATION_ENABLED=false
DIARIZATION_HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Feedback-Push (Sprint F1/F2) ──────────────────────────────────
# Benachrichtigung, wenn ein Therapeut Feedback zu einer Ausgabe abgibt.
#   off      → keine Benachrichtigung (Default)
#   worker   → EMPFOHLEN: der Cloudflare Worker versendet die Nachricht.
#              Der Pod haelt dann KEIN Telegram-Secret; signiert wird mit dem
#              ohnehin vorhandenen CONFLUENCE_SHARED_SECRET.
#   telegram → Fallback: Pod sendet direkt an Telegram (dupliziert den
#              Bot-Token auf die Maschine mit den Klientendaten).
#
# ORT: auf dem Pod in /workspace/.env - runpod-start.sh sourct die Datei mit
# "set -a", die Werte landen damit in der Prozessumgebung von uvicorn. Sie
# liegt auf dem persistenten Network Volume und ueberlebt Stop/Resume.
#
# Die Push-Nachricht enthaelt bewusst NIE den Feedback-Freitext (DSGVO):
# der bleibt allein in feedback.log auf dem Pod.
FEEDBACK_NOTIFY=off

# Nur fuer FEEDBACK_NOTIFY=worker (nicht geheim):
WORKER_NOTIFY_URL=https://control.scriptelios.win/notify

# Nur fuer FEEDBACK_NOTIFY=telegram (Fallback):
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Cloudflare Named Tunnel ───────────────────────────────────────
# Oeffentlicher Hostname, unter dem das Backend erreichbar ist. Rein
# kosmetisch (Ausgabe von runpod-start.sh) - das tatsaechliche Routing
# kommt aus der Public-Hostname-Konfiguration des Tunnels im Zero-Trust-
# Dashboard. Muss mit dieser uebereinstimmen.
TUNNEL_HOSTNAME=api.scriptelios.win

# ── v19.33: Latenz / GPU-Profil ──────────────────────────────────
# Obergrenze des Kontextfensters je LLM-Call (Pod mit 32 GB + q8_0-KV: 32768).
LLM_NUM_CTX_CAP=32768
# true = JEDER LLM-Call nutzt num_ctx=LLM_NUM_CTX_CAP. Verhindert, dass
# Ollama ein Modell wegen eines anderen num_ctx neu laedt (Dialog-Latenz).
# Abnahme nach dem Umschalten: `ollama ps` muss "100% GPU" zeigen.
LLM_FIXED_CTX=false
# single = eine 32-GB-GPU (ein LLM resident, MAX_LOADED_MODELS=1)
# dual   = zwei GPUs: gemma + mistral + nomic resident (MAX_LOADED_MODELS=3),
#          Vorladen beim Start, Whisper bleibt geladen. runpod-start.sh
#          faellt mit Warnung auf single zurueck, wenn < 2 GPUs da sind.
#          Nach einem Wechsel Ollama neu starten (pkill -f 'ollama serve').
GPU_PROFILE=single

# ── v19.34: Vorrang laufender Interviews (nur GPU_PROFILE=single) ─
# Waehrend ein Interview laeuft, starten neue LLM-Jobs und P0-Transkriptionen
# nicht. Reservierung verfaellt nach IDLE Sekunden ohne Aktivitaet; kein Job
# wartet laenger als MAX_JOB_WAIT Sekunden.
INTERVIEW_PRIORITY=true
INTERVIEW_LEASE_IDLE_S=300
INTERVIEW_MAX_JOB_WAIT_S=600

# ── v19.35: Server-Vorlesen (Testphase: Browser | Piper | Chatterbox) ─
# Einrichtung einmalig: bash backend/scripts/setup_tts.sh [--chatterbox]
# (eigenes venv /workspace/venv-tts, Dienst auf 127.0.0.1:8011, CPU).
TTS_ENABLED=false
TTS_SERVICE_URL=http://127.0.0.1:8011
# v19.39/v19.40.1: Standardstimme - z.B. chatterbox:gunther (Datei
# /workspace/tts/voices/gunther.wav) oder "browser" (schnell). Laeuft Chatterbox
# auf der CPU, wird automatisch "browser" vorgeschlagen (sonst Pausen).
TTS_DEFAULT_VOICE=chatterbox:gunther
# v19.40: Chatterbox auf der GPU (setup_tts.sh --cuda); nur mit >= 5 GB frei,
# bei Speicherfehler Rueckfall auf CPU. Getestet: gemma + Chatterbox < 31 GB.
TTS_CHATTERBOX_DEVICE=cuda
TTS_GPU_MIN_FREE_GB=5
# Nur fuer den Dienst (runpod-start.sh reicht sie durch):
TTS_CHATTERBOX_ENABLED=false
TTS_PIPER_THREADS=2
TTS_CHATTERBOX_THREADS=8

# v19.44: Modell, das runpod-start.sh beim Start in den Grafikspeicher laedt
# (leer = OLLAMA_MODEL). Sinnvoll: das meistgenutzte Modell, z.B. gemma4:31b
WARMUP_MODEL=
